# Banco de Dados PostgreSQL
POSTGRES_DB=pme_scoring_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=senha_segura_postgres
DB_DDL_AUTO=update

# Aplicação Spring Boot
SERVER_PORT=8080
LOG_PATH=/app/logs
JWT_SECRET=sua_chave_secreta_jwt_super_segura_aqui
SOURCE_ID=docker-env

# Timeouts e Limites (Essenciais para exportações grandes de CSV / Streaming)
SPRING_MVC_ASYNC_REQUEST_TIMEOUT=300000
SERVER_TOMCAT_CONNECTION_TIMEOUT=300000
SERVER_TOMCAT_MAX_HTTP_FORM_POST_SIZE=2MB

# Usuário administrador padrão
ADMIN_DEFAULT_EMAIL=admin@admin.com
ADMIN_DEFAULT_PASSWORD=admin123

# CORS
CORS_ALLOWED_ORIGIN_PATTERNS=*,http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,HEAD,PATCH
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Cache-Control
CORS_ALLOW_CREDENTIALS=true

# Ambiente
SPRING_PROFILES_ACTIVE=prod

# Documentação da API
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true